# ======================================================================
# Variables d'environnement — copier en .env (local) ou les définir dans
# wrangler.toml ([vars] + [env.preview.vars]) ; le tableau de bord Pages n'accepte que les secrets
# Les variables lues AU BUILD (front) ne doivent contenir AUCUN secret.
# ======================================================================

# --- lues au build (exposées au navigateur : jamais de secret ici) ---
SITE_URL=https://calend.run           # domaine public, sans / final (canonical, sitemap, OG, mails)
ALERTS_ENABLED=false                   # "true" seulement quand Brevo + Turnstile sont configurés
ACCOUNTS_ENABLED=                      # vide = valeur de brand.config.js (true) ; "false" pour masquer les comptes
TURNSTILE_SITE_KEY=                    # clé PUBLIQUE Turnstile ; vide = valeur de brand.config.js
UMAMI_SRC=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=                      # vide = pas de mesure d'audience

# --- côté serveur uniquement (Pages Functions + worker de rappels) : secrets ---
BREVO_API_KEY=                         # secret
BREVO_LIST_ID=                         # id de la liste « Alertes » dans Brevo
BREVO_DOI_TEMPLATE_ID=                 # id du template d'e-mail double opt-in
TURNSTILE_SECRET_KEY=                  # secret
UNSUB_SECRET=                          # secret long et aléatoire (jetons de désinscription)
AUTH_PEPPER=                           # secret long et aléatoire (poivre des mots de passe) — NE JAMAIS LE CHANGER une fois des comptes créés
SENDER_EMAIL=alertes@calend.run       # expéditeur vérifié dans Brevo (worker de rappels)
# formulaire de contact : destinataire et expéditeur fixés dans workers/mailer/wrangler.toml (Email Routing)
ALLOWED_ORIGINS=                       # optionnel : origines en plus de SITE_URL (ex. https://calendrun.pages.dev pendant la transition)
